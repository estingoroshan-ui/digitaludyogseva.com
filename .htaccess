# ==========================================================================
# DIGITAL UDYOG SEVA (digitaludyogseva.com) - PRODUCTION APACHE HTACCESS
# ==========================================================================

# 1. Default Index Page (prioritize index.php React loader)
DirectoryIndex index.php index.html

# 2. Rewrite Engine & Front Controller for React SPA
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /assets/ to /dist/assets/ if needed
    RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

    # Don't touch actual existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't rewrite API endpoints
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # Send all other requests to index.php for client-side React SPA routing
    RewriteRule ^ index.php [L]
</IfModule>

# 3. Disable Directory Browsing for Security
Options -Indexes

# 4. Protect Sensitive Files & Configs
<FilesMatch "\.(sql|log|env|git|gitignore|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent direct browsing of database connection
<FilesMatch "^(db\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# 6. Browser Caching for Production JS/CSS/Images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# 7. Default Charset UTF-8
AddDefaultCharset UTF-8
