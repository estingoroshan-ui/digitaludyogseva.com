# ==========================================================================
# DIGITAL UDYOG SEVA (digitaludyogseva.com) - PRODUCTION APACHE HTACCESS
# ==========================================================================

# Default Index Page
DirectoryIndex index.php index.html

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Front Controller / Clean URLs fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9\-]+)$ service.php?slug=$1 [L,QSA]
</IfModule>

# 2. Disable Directory Browsing for Security
Options -Indexes

# 3. Protect Sensitive System Files & SQL Backups
<FilesMatch "\.(sql|log|md|env|json|git|gitignore|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent direct browsing of config and database files
<FilesMatch "^(db\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# 5. Enable Browser Caching for Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# 6. Default Charset UTF-8
AddDefaultCharset UTF-8
